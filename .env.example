# Copie ce fichier en « .env » et remplis ce dont tu as besoin.

# Clé API Claude (optionnelle) : sans elle, les sujets viennent de content/banque_sujets.json.
# Avec elle, un sujet nouveau est généré à chaque vidéo. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Nombre de vidéos produites à chaque lancement automatique
NB_VIDEOS=1

# Voix edge-tts (fr-FR-HenriNeural, fr-FR-DeniseNeural, fr-FR-RemyMultilingualNeural…)
VOIX=fr-FR-HenriNeural
