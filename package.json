{
  "name": "ia-tiktok",
  "version": "1.0.0",
  "private": true,
  "description": "Système de production de vidéos TikTok (outils IA & astuces tech) avec Remotion",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts",
    "still": "remotion still src/index.ts",
    "typecheck": "tsc --noEmit",
    "produce": "python3 -m pipeline.produce",
    "setup": "pip3 install -r requirements.txt"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/media": "4.0.529",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.529",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
